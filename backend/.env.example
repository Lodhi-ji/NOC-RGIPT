# ---- Local demo (works with zero setup) ----
PORT=5000
JWT_SECRET=change_me_to_a_long_random_string
# DEMO_MODE=true: auto-creates demo accounts + sample applications, shows OTPs in the UI,
# relaxes rate limits. NEVER enable in production.
DEMO_MODE=true

# ---- Production / real deployment (all optional for local demo) ----
# MONGO_URI=mongodb+srv://user:pass@cluster/noc_portal   # empty => local MongoDB in backend/.localdb
# CLIENT_URLS=https://your-frontend.vercel.app           # empty => any http://localhost origin allowed
# REDIS_URL=redis://127.0.0.1:6379                       # empty => no cache, emails sent directly
# WEB_CONCURRENCY=4                                      # Node cluster workers (needs MONGO_URI)
# RESEND_SMTP_URL=re_xxx  or  SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASSWORD   # empty => emails printed to console
# MAIL_FROM=NOC Portal <noreply@rgipt.ac.in>
MONGO_DB_NAME=noc_demo     # optional: database name inside the cluster
